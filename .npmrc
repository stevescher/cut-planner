; Enforce the "engines" field in package.json instead of only warning.
; The dependency tree has hard floors that exclude Node 21 and 23 (non-LTS)
; and Node <20.19 / <22.13 -- see OPUS-422. Without this, npm install on an
; unsupported Node prints a warning and proceeds, producing a tree that fails
; at build or lint time instead of at install time.
engine-strict=true
